<?xml version="1.0" encoding="utf-8"?>
<com.techlabs.apdcl.Utils.WhalesDrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".Activity.fragments.MapFragment"
    tools:openDrawer="start">

            <RelativeLayout
                android:id="@+id/r_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.osmdroid.views.MapView
                    android:id="@+id/map"
                    tilesource="Mapnik"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:clickable="true"
                    android:drawingCacheQuality="high"
                    android:scrollbarAlwaysDrawHorizontalTrack="true"
                    android:scrollbarAlwaysDrawVerticalTrack="true"
                    android:nestedScrollingEnabled="true" />

                <LinearLayout
                    android:id="@+id/menu_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="3.0">

                    <ImageButton
                        android:id="@+id/drawer_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.350"
                        android:background="@null"
                        android:paddingLeft="8sp"
                        android:paddingTop="5sp"
                        android:paddingRight="5sp"
                        android:paddingBottom="5sp"
                        android:src="@drawable/menu_icons" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="8sp"
                        android:layout_weight="0.350"
                        android:gravity="center"
                        android:orientation="vertical">

                        <AutoCompleteTextView
                            android:id="@+id/filters_autocomplete_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/search_box_background"
                            android:gravity="center"
                            android:hint="Search here"
                            android:padding="5sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/search_img"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.350"
                        android:background="@null"
                        android:padding="5sp"
                        android:src="@drawable/search_icon" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="100dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="95dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/zoom_out"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@null"
                        android:paddingLeft="2sp"
                        android:paddingRight="2sp"
                        android:src="@drawable/minimum" />

                    <ImageButton
                        android:id="@+id/zoom_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:background="@null"
                        android:paddingLeft="2sp"
                        android:paddingRight="2sp"
                        android:src="@drawable/maximum" />

                    <ImageButton
                        android:id="@+id/downTracing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@null"
                        android:paddingLeft="2sp"
                        android:paddingRight="2sp"
                        android:src="@drawable/down_tracing" />

                    <ImageButton
                        android:id="@+id/upTracing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@null"
                        android:paddingLeft="2sp"
                        android:paddingRight="2sp"
                        android:src="@drawable/up_tracing" />

                    <ImageButton
                        android:id="@+id/location_marker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@null"
                        android:paddingLeft="2sp"
                        android:paddingRight="2sp"
                        android:src="@drawable/location_markers" />

                    <ImageButton
                        android:id="@+id/analysis_img_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@null"
                        android:paddingLeft="2sp"
                        android:paddingRight="2sp"
                        android:tint="@color/black"/>

                </LinearLayout>

            </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical"
            android:paddingLeft="10sp"
            android:paddingRight="10sp">

            <TextView
                android:id="@+id/feederTitle_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alfa_slab_one"
                android:paddingLeft="10sp"
                android:paddingTop="10sp"
                android:paddingRight="10sp"
                android:text="Network"
                android:textColor="@color/blue"
                android:textSize="16sp" />

            <View
                android:id="@+id/under_view"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_below="@+id/feederTitle_tv"
                android:layout_marginLeft="10sp"
                android:background="@color/blue"
                android:paddingRight="10sp" />

            <ExpandableListView
                android:id="@+id/topology_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/under_view"
                android:background="@android:color/white"
                android:dividerHeight="0dp"
                android:groupIndicator="@drawable/expand_indicater"
                android:padding="10sp" />

            <View
                android:id="@+id/under_view2"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_below="@+id/feederTitle_tv"
                android:layout_marginLeft="10sp"
                android:background="@color/blue"
                android:paddingRight="10sp" />

            <SearchView
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/feeder_list"
                android:background="@drawable/search_box_background"
                android:iconifiedByDefault="false"
                android:queryHint="Search here"
                android:layout_marginTop="5sp"/>

            <ExpandableListView
                android:id="@+id/navigationmenu"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_below="@+id/search"
                android:background="@android:color/white"
                android:dividerHeight="0dp"
                android:groupIndicator="@drawable/expand_indicater" />

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>

</com.techlabs.apdcl.Utils.WhalesDrawerLayout>