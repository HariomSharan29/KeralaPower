<?xml version="1.0" encoding="utf-8"?>
<com.techlabs.apdcl.Utils.WhalesDrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:openDrawer="start">

    <RelativeLayout
        android:id="@+id/r_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            tilesource="Mapnik"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:clickable="true"
            android:drawingCacheQuality="high"
            android:nestedScrollingEnabled="true" />

        <LinearLayout
            android:id="@+id/menu_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="3.0">

            <ImageButton
                android:id="@+id/drawer_btn"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_weight=".20"
                android:background="@null"
                android:paddingStart="8sp"
                android:paddingTop="5sp"
                android:paddingEnd="5sp"
                android:paddingBottom="5sp"
                android:src="@drawable/menu_icons"
                app:tint="@color/blue" />

            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="2.9"
                android:elevation="8dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingEnd="10dp">

                <AutoCompleteTextView
                    android:id="@+id/searchView"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="-25dp"
                    android:layout_weight="0"
                    android:background="@drawable/search_bg"
                    android:hint="@string/search"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="14sp"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/search_icon"
                    app:tint="@color/blue" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/side_l_Layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="95dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/tools_toggle_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/round_fab_bg"
                android:clipToOutline="true"
                android:contentDescription="Tools"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/features"
                app:tint="@color/white" />

            <LinearLayout
                android:id="@+id/tools_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/zoom_out"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/minimum"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/zoom_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/maximum"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/upTracing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/up_tracing"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/downTracing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/down_tracing"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/location_marker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/location_markers"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/analysis_img_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/renewable"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/new_connection_loadFlow_status_imgBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/new_connection_loadflow"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/reportBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/report"
                    android:visibility="visible"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/reloadNetwork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/ic_cycle"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/deleteBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/delete"
                    android:visibility="gone"
                    app:tint="@color/blue" />

                <ImageButton
                    android:id="@+id/draw_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/add_section_background"
                    android:padding="3dp"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/new_line" />

                <ImageButton
                    android:id="@+id/device_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/add_section_background"
                    android:padding="3dp"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:src="@drawable/color_code"
                    android:visibility="visible"
                    app:tint="@color/blue" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/spinkitLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="vertical">

            <com.techlabs.apdcl.Utils.ProgressBarLayout
                android:id="@+id/progress_bar_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="visible" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/mapLayer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_above="@+id/spinkitLayout"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/add_section_background"
            android:padding="8dp"
            android:src="@drawable/layer"
            android:visibility="visible"
            app:tint="@color/blue" />

        <ImageButton
            android:id="@+id/colorCodeView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_above="@+id/mapLayer"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/add_section_background"
            android:padding="8dp"
            android:src="@drawable/ic_legend"
            android:visibility="visible"
            app:tint="@color/blue" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true">

            <LinearLayout
                android:id="@+id/log_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#FFFFFF"
                android:elevation="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/blue"
                    android:elevation="3dp"
                    android:orientation="horizontal"
                    android:weightSum="4.2">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1.12"
                        android:padding="4dp"
                        android:text="Severity"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1.2"
                        android:padding="4dp"
                        android:text="Code"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:padding="4dp"
                        android:text="Message"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/closeBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginStart="100dp"
                        android:layout_weight=".85"
                        android:contentDescription="Close"
                        android:src="@drawable/close"
                        android:tint="@color/white"
                        tools:ignore="UseAppTint" />

                </LinearLayout>

                <ScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="true">

                        <LinearLayout
                            android:id="@+id/tableLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/log"
                            android:orientation="vertical" />

                    </HorizontalScrollView>
                </ScrollView>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/bottomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:gravity="bottom" />

    </RelativeLayout>

    <FrameLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#fff"
        android:fitsSystemWindows="true"
        android:isScrollContainer="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="18dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/rv_bg"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="29dp"
                        app:cardElevation="4dp"
                        android:layout_gravity="start"
                        app:strokeColor="@color/blue"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/navLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/utilitynet_app"
                            android:padding="12dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/kerala_logo" />
                    </com.google.android.material.card.MaterialCardView>

                    <ImageView
                        android:id="@+id/navCompanyLogo"
                        android:layout_width="60dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:layout_gravity="start"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ttpl_logo" />

                    <TextView
                        android:id="@+id/navPoweredBy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Powered by Trident Tech Labs"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/navVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:layout_gravity="start"
                        android:textStyle="bold"
                        tools:text="Version 2.3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="top"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/navUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/blue"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <SearchView
                android:id="@+id/search"
                style="@style/AppSearchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_box_background"
                android:closeIcon="@drawable/ic_clear"
                android:iconifiedByDefault="false"
                android:queryHint="@string/hint_search_mess"
                android:searchHintIcon="@color/blue"
                android:searchIcon="@drawable/ic_search"
                android:textColor="@color/black"
                android:visibility="visible" />

            <ExpandableListView
                android:id="@+id/navigationmenu"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:groupIndicator="@drawable/expand_indicater"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:visibility="visible" />

            <Button
                android:id="@+id/navLoadBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_background"
                android:text="Load / Unload Network"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

</com.techlabs.apdcl.Utils.WhalesDrawerLayout>


