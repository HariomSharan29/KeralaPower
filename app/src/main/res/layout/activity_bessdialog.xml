                        android:paddingLeft="5sp"
                        android:inputType="numberDecimal"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:background="@drawable/edt_txt_background" />

                </LinearLayout>
                <LinearLayout
