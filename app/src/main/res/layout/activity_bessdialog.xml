                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:padding="5sp"
                        android:text="kW"
                        android:textColor="@color/black"
                        android:textSize="12sp"
